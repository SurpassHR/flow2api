+async def _stream_with_sse_heartbeat(agen, interval: float = 15.0):
+    """SSE 心跳包装器:内层生成器长时间无数据时,定期发送一行 SSE 注释。
+
+    Cloudflare 免费版对空闲响应约 100 秒切断,而图片生成在"打码+提交"阶段
+    可能 60~120 秒不产生任何流事件。SSE 注释行(": keepalive")会被标准客户端
+    忽略,但能让 Cloudflare/nginx 的空闲计时器复位,避免流被中途掐断。
+
+    客户端断开时,外层生成器被取消 → pump 任务随之取消 → CancelledError
+    传入内层 handle_generation,其"生成已取消"逻辑保持不变。
+    """
+    queue: asyncio.Queue = asyncio.Queue()
+    _SENTINEL = object()
+
+    async def _pump():
+        try:
+            async for chunk in agen:
+                queue.put_nowait(chunk)
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:  # noqa: BLE001
+            queue.put_nowait(exc)
+        finally:
+            queue.put_nowait(_SENTINEL)
+
+    task = asyncio.create_task(_pump())
+    try:
+        while True:
+            try:
+                item = await asyncio.wait_for(queue.get(), timeout=interval)
+            except asyncio.TimeoutError:
+                yield ": keepalive\n\n"
+                continue
+            if item is _SENTINEL:
+                break
+            if isinstance(item, Exception):
+                raise item
+            yield item
+    finally:
+        task.cancel()
+        try:
+            await task
+        except asyncio.CancelledError:
+            pass
+
